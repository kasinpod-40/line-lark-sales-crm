{
  "name": "line-lark-sales-crm",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "rm -rf .tmp-test && tsc -p tsconfig.test.json && node -e \"require('fs').writeFileSync('.tmp-test/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\" && node --test test/*.test.cjs",
    "bundle": "wrangler deploy --dry-run --config wrangler.ci.jsonc",
    "check": "npm run typecheck && npm test && npm run bundle",
    "lark:base:plan": "node scripts/provision-lark-base.mjs",
    "lark:base:apply": "node scripts/provision-lark-base.mjs --apply",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-types": "wrangler types"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "wrangler": "^4.0.0"
  }
}
