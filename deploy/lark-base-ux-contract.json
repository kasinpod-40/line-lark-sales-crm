        {"name": "💎 VIP Customers", "type": "statistics", "data_config": {"table_name": "Customers", "count_all": true, "filter": {"conjunction": "or", "conditions": [{"field_name": "vip_status", "operator": "is", "value": "🥇 Gold VIP"}, {"field_name": "vip_status", "operator": "is", "value": "💎 Diamond VIP"}]}}, "position": {"x": 0, "y": 5, "w": 3, "h": 3}},
        {"name": "🔥 Hot Leads", "type": "statistics", "data_config": {"table_name": "Customers", "count_all": true, "filter": {"conjunction": "and", "conditions": [{"field_name": "hot_lead", "operator": "is", "value": true}]}}, "position": {"x": 3, "y": 5, "w": 3, "h": 3}},
