        {"name": "🪜 Customer Stage Mix", "type": "pie", "data_config": {"table_name": "Customers", "count_all": true, "group_by": [{"field_name": "customer_stage", "mode": "integrated"}]}, "position": {"x": 0, "y": 13, "w": 6, "h": 5}},
