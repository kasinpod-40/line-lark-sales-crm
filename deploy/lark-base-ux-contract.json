        {"name": "📂 Open Cases", "type": "statistics", "data_config": {"table_name": "Chat_Tracking", "count_all": true, "filter": {"conjunction": "and", "conditions": [{"field_name": "record_type", "operator": "is", "value": "CASE"}, {"field_name": "case_status", "operator": "isNot", "value": "RESOLVED"}]}}, "position": {"x": 0, "y": 2, "w": 3, "h": 3}},
