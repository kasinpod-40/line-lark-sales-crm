        {"name": "⚡ SLA Distribution", "type": "pie", "data_config": {"table_name": "Chat_Tracking", "count_all": true, "group_by": [{"field_name": "sla_status", "mode": "integrated"}], "filter": {"conjunction": "and", "conditions": [{"field_name": "record_type", "operator": "is", "value": "CASE"}]}}, "position": {"x": 6, "y": 5, "w": 6, "h": 5}},
